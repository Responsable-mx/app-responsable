# Variables para tests E2E — copiar a .env.local o exportar antes de correr
# cp e2e/.env.e2e.example .env.e2e && set -a && source .env.e2e && npm run test:e2e

# Email de un consultor activo en la base de datos
E2E_TEST_EMAIL=consultor@responsable.net

# ID de un cliente existente con cuestionario ya iniciado
E2E_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL del app (default: http://localhost:3000)
# Para smoke test contra producción: https://app.responsable.net
E2E_BASE_URL=http://localhost:3000

